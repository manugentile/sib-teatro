---
import { getCollection } from "astro:content";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../config";
import SiteLayout from "../../layouts/SiteLayout.astro";

const chiSiamoEntries = (await getCollection("chi_siamo"))
  .map((entry) => ({
    slug: entry.slug,
    title: entry.data.title,
    pubDate: entry.data.pubDate,
    pubDateIso: entry.data.pubDate
      ? new Date(entry.data.pubDate).toISOString()
      : undefined,
  }))
  .sort(
    (a, b) =>
      new Date(b.pubDate ?? 0).valueOf() - new Date(a.pubDate ?? 0).valueOf(),
  );

// const chiSiamo = chiSiamoEntries[0];
---

<SiteLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="px-6 lg:px-20 py-10">
    <ul class="space-y-4">
      {
        chiSiamoEntries.map((chiSiamoEntry) => (
          <li>
            <time
              datetime={chiSiamoEntry.pubDateIso}
              class="text-xs text-slate-500 block"
            >
              {new Date(chiSiamoEntry.pubDate ?? 0).toLocaleDateString(
                "it-IT",
                {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                },
              )}
            </time>
            <a
              class="font-serif italic text-xl hover:text-primary transition-colors"
              href={`/chi-siamo/${chiSiamoEntry.slug}`}
            >
              {chiSiamoEntry.title}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</SiteLayout>
