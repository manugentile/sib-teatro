---
import { getCollection } from "astro:content";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../config";
import SiteLayout from "../../layouts/SiteLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("chi_siamo");
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const frontmatter = entry.data;
---

<SiteLayout
  title={frontmatter.title || SITE_TITLE}
  description={frontmatter.description || SITE_DESCRIPTION}
>
  <section class="px-6 lg:px-20 py-10">
    <header class="mb-8">
      <h1 class="text-4xl md:text-5xl font-serif italic">
        {frontmatter.title}
      </h1>
    </header>

    <div class="flex flex-col md:flex-row md:items-start gap-8">
      <article class="flex-1 prose max-w-none">
        <Content />
      </article>

      {
        frontmatter.sideImage && (
          <figure class="w-full md:w-1/3 shrink-0 flex justify-center items-center">
            <img
              src={frontmatter.sideImage}
              alt="Logo"
              class="max-w-xs w-full h-auto object-contain"
            />
          </figure>
        )
      }
    </div>

    {
      frontmatter.mainImage && (
        <figure class="mt-10">
          <img
            src={frontmatter.mainImage}
            alt="Foto gruppo"
            class="w-full h-auto rounded-2xl"
          />
        </figure>
      )
    }
  </section>
</SiteLayout>
