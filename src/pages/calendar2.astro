---
import { getCollection } from "astro:content";
import FullCalendar from "../components/Calendar.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../config";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getUpcomingEvents, getPastEvents } from '../lib/calendar';

const upcomingEvents = await getUpcomingEvents(5);
const pastEvents = await getPastEvents(5);

// Helper per formattare la data in modo sicuro
const formatDate = (rawDate?: string) => {
  if (!rawDate) return "Data non disponibile";
  
  const parsedDate = new Date(rawDate);
  // Controllo di sicurezza se la data non è valida
  if (isNaN(parsedDate.getTime())) return "Data non valida";

  return new Intl.DateTimeFormat("it-IT", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  }).format(parsedDate);
};
---

<SiteLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="py-24 px-6 max-w-4xl mx-auto mb-24">
    <h1 class="text-6xl font-serif italic mb-4">Calendario</h1>
    <p class="text-slate-500 mb-16 uppercase tracking-widest text-sm font-bold">
      Le date della stagione teatrale
    </p>
    <FullCalendar /> 
  </section>

  <section class="py-24 px-6 max-w-4xl mx-auto opacity-60">
    <h2 class="text-xl font-serif mb-8 text-slate-400">Prossimi Eventi</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {
        upcomingEvents.length > 0 ? (
          upcomingEvents.map((event) => {
            const rawDate = event.start?.dateTime || event.start?.date;
            return (
              <div class="flex items-center gap-4 border-l-2 border-slate-200 pl-4 py-2">
                <div>
                  <p class="text-[10px] font-bold uppercase text-slate-400">
                    {formatDate(rawDate)}
                  </p>
                  <h4 class="font-serif">{event.summary || "Senza titolo"}</h4>
                  {event.location && <p class="text-xs text-slate-500">{event.location}</p>}
                </div>
              </div>
            );
          })
        ) : (
          <p class="text-sm text-slate-400 italic">Nessun prossimo evento in programma.</p>
        )
      }
    </div>
  </section>

  <section class="py-24 px-6 max-w-4xl mx-auto opacity-60">
    <h2 class="text-xl font-serif mb-8 text-slate-400">Archivio Eventi</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {
        pastEvents.length > 0 ? (
          pastEvents.map((event) => {
            const rawDate = event.start?.dateTime || event.start?.date;
            return (
              <div class="flex items-center gap-4 border-l-2 border-slate-200 pl-4 py-2">
                <div>
                  <p class="text-[10px] font-bold uppercase text-slate-400">
                    {formatDate(rawDate)}
                  </p>
                  <h4 class="font-serif">{event.summary || "Senza titolo"}</h4>
                  {event.location && <p class="text-xs text-slate-500">{event.location}</p>}
                </div>
              </div>
            );
          })
        ) : (
          <p class="text-sm text-slate-400 italic">Nessun evento passato in archivio.</p>
        )
      }
    </div>
  </section>
</SiteLayout>