---
import { getCollection } from "astro:content";
import FullCalendar from "../components/Calendar.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../config";
import SiteLayout from "../layouts/SiteLayout.astro";

// 1. Recupera tutti gli eventi
const allEvents = (await getCollection("events")).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);

const events = allEvents.map((entry) => {
  const date = new Date(entry.data.date ?? 0);
  const month = date
    .toLocaleDateString("it-IT", { month: "short" })
    .replace(".", "");
  const monthCapitalized = month.charAt(0).toUpperCase() + month.slice(1);
  const day = date.toLocaleDateString("it-IT", { day: "2-digit" });

  return {
    month: monthCapitalized,
    day,
    title: entry.data.title,
    venue: entry.data.venue,
    time: entry.data.time,
    date: entry.data.date,
  };
});

// 2. Ottieni la data attuale
const now = new Date();

// 3. Ordina e filtra
const upcomingEvents = events
  .filter((event) => new Date(event.date) >= now)
  .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());

const pastEvents = events
  .filter((event) => new Date(event.date) < now)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat("it-IT", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  }).format(date);
};
---

<SiteLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="py-24 px-6 max-w-4xl mx-auto mb-24">
    <h1 class="text-6xl font-serif italic mb-4">Calendario</h1>
    <p class="text-slate-500 mb-16 uppercase tracking-widest text-sm font-bold">
      Le date della stagione teatrale
    </p>
    <h2 class="text-2xl font-serif mb-8 border-b border-slate-100 pb-4">
      Prossimi Appuntamenti
    </h2>
    <FullCalendar />
