---
// Layout per la homepage stile Roundabout Theatre
import "../styles/global.css";

---

<div class="relative bg-black text-white min-h-screen flex flex-col">
  <header class="w-full bg-black/80 border-b border-white/10">
    <slot name="header" />
  </header>
  <main
    class="flex-1 flex flex-col items-center justify-center px-4 py-12 md:py-24"
  >
    <slot />
  </main>
  <footer class="w-full bg-black/80 border-t border-white/10 mt-auto">
    <slot name="footer" />
  </footer>
</div>
