---
import type { MDXLayoutProps } from "astro";
import SiteLayout from "./SiteLayout.astro";

type Props = MDXLayoutProps<{
  title: string;
  description: string;
  pubDate?: string;
  updatedDate?: string;
  heroImage?: string;
}>;

const { frontmatter } = Astro.props;
---

<SiteLayout
  title={frontmatter.title}
  description={frontmatter.description ?? frontmatter.title}
  image={frontmatter.heroImage}
>
  <article class="px-6 lg:px-20 py-10">
    {
      frontmatter.heroImage && (
        <img width={720} height={360} src={frontmatter.heroImage} alt="" />
      )
    }
    <h1 class="text-3xl md:text-4xl font-serif italic mb-2">
      {frontmatter.title}
    </h1>
    {
      frontmatter.pubDate && (
        <time class="text-sm text-slate-500">
          {frontmatter.pubDate.substring(0, 10)}
        </time>
      )
    }
    {
      frontmatter.updatedDate && (
        <div class="text-sm text-slate-500">
          Last updated on{" "}
          <time>{frontmatter.updatedDate.substring(0, 10)}</time>
        </div>
      )
    }
    <hr class="my-6 border-slate-200" />
    <slot />
  </article>
</SiteLayout>
