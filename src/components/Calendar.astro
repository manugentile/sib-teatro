---
// Ricevi l'ID del calendario da TinaCMS come prop
const { calendarId } = Astro.props;
---

<div id="calendar-teatro"></div>

<!-- Dialog / Modale nascosto per i dettagli dell'evento -->
<dialog id="event-modal" class="p-6 rounded-lg shadow-xl backdrop:bg-black/50">
  <h3 id="modal-title" class="text-xl font-bold mb-2"></h3>
  <p id="modal-time" class="text-sm text-gray-500 mb-4"></p>
  <p id="modal-location" class="text-sm text-gray-500 mb-4"></p>
  <div id="modal-description" class="text-base mb-6"></div>
  
  <div class="flex gap-2 justify-end">
    <a id="modal-link" href="#" target="_blank" class="px-4 py-2 bg-blue-600 text-white rounded">Vedi su Google</a>
    <button id="modal-close" class="px-4 py-2 bg-gray-200 rounded">Chiudi</button>
  </div>
</dialog>

<script>
  import { Calendar } from '@fullcalendar/core';
  import dayGridPlugin from '@fullcalendar/daygrid';
  import googleCalendarPlugin from '@fullcalendar/google-calendar';
  import itLocale from '@fullcalendar/core/locales/it';

  function setupCalendar() {
    console.log("Tentativo di renderizzazione...");
    const calendarEl = document.getElementById('calendar-teatro');
    const apiKey = import.meta.env.PUBLIC_GOOGLE_CALENDAR_API_KEY;
    const calendarId = import.meta.env.PUBLIC_GOOGLE_CALENDAR_ID;
    if (calendarEl) {
      console.log("Tentativo di renderizzazione...");
      const calendar = new Calendar(calendarEl, {
        plugins: [dayGridPlugin, googleCalendarPlugin],
        initialView: 'dayGridMonth',
        displayEventEnd: true,
        eventTimeFormat: {
          hour: '2-digit',
          minute: '2-digit',
          meridiem: false, // Disabilita AM/PM
          hour12: false    // Usa il formato h24
        },
        googleCalendarApiKey: apiKey, // Astro la inietterà qui
        // events: '',
        events: {
          googleCalendarId: calendarId // Usa l'oggetto, non solo la stringa
        },
        locale: itLocale,
        headerToolbar: {
          left: 'prev,next today',
          center: 'title',
          right: 'dayGridMonth,dayGridWeek'
        },
        eventClick: function(info) {
          // Evita che il browser segua un link predefinito se l'evento ne ha uno
          info.jsEvent.preventDefault();

          const formatOptions = { hour: '2-digit', minute: '2-digit' };
          const startTime = info.event.start?.toLocaleString('it-IT', formatOptions);
          const endTime = info.event.end?.toLocaleString('it-IT', formatOptions);
          const timeText = endTime ? `${startTime} - ${endTime}` : startTime;

          const modal = document.getElementById('event-modal');
          document.getElementById('modal-title').innerText = info.event.title;
          document.getElementById('modal-time').innerText = timeText;
          document.getElementById('modal-location').innerText = info.event.extendedProps.location ? `📍 ${info.event.extendedProps.location}` : '';
          document.getElementById('modal-description').innerText = info.event.extendedProps.description || '';
          
          const linkBtn = document.getElementById('modal-link');
          if (info.event.url) {
            linkBtn.href = info.event.url;
            linkBtn.style.display = 'inline-block';
          } else {
            linkBtn.style.display = 'none';
          }

          modal.showModal(); // Apri il dialogo nativo HTML5
        },
        eventContent: function(arg) {
          const title = arg.event.title;
          const location = arg.event.extendedProps.location;

          // Crea elementi HTML personalizzati da inserire nella casella
          let customEl = document.createElement('div');
          customEl.className = 'fc-custom-event';
          
          customEl.innerHTML = `
            <strong>${arg.timeText}</strong>
            <div style="font-weight: bold;">${title}</div>
            ${location ? `<small style="font-size: 0.8em; opacity: 0.8;">📍 ${location}</small>` : ''}
          `;

          return { domNodes: [customEl] };
        }
      });
      calendar.render();
    }
  };

  document.getElementById('modal-close')?.addEventListener('click', () => {
    document.getElementById('event-modal').close();
  });

  // Esegue la funzione al caricamento iniziale
  setupCalendar();

  // Esegue la funzione ogni volta che Astro cambia pagina (se usi View Transitions)
  document.addEventListener('astro:page-load', setupCalendar);
</script>

<style>
  /* Qui puoi rendere il calendario simile a un date-picker moderno */
  #calendar-teatro {
    max-width: 900px;
    margin: 40px auto;
    font-family: sans-serif;
  }
</style>

<style is:global>
  /* Permette al testo dell'evento di andare a capo */
  .fc-daygrid-event {
    white-space: normal !important;
    align-items: flex-start !important;
  }

  .fc-daygrid-event .fc-event-title {
    color: #dc2626 !important;
    font-weight: bold !important;
    white-space: normal !important;
    word-break: break-word; /* Spezza le parole molto lunghe se non c'è spazio */
  }

  .fc-daygrid-event .fc-event-time {
    color: #9ca3af !important;
    font-size: 0.75rem !important;
    font-weight: 500 !important;
    margin-right: 4px;
  }
</style>