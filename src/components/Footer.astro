---
const today = new Date();
---

<footer
  class="py-12 px-6 border-t border-slate-100 flex flex-col md:flex-row justify-between items-center gap-6"
>
  <div class="flex items-center gap-2">
    <div class="w-10 h-10 flex items-center justify-center">
      <img alt="Logo Salti In Bocca Teatro" src="/logo-sib-new.png" />
    </div>
    <p class="text-xs font-bold uppercase tracking-widest text-slate-400">
      Salti In Bocca Teatro
    </p>
  </div>
  <p class="text-[11px] text-slate-400 uppercase tracking-widest">
    © {today.getFullYear()} — Made with passion in Susa Valley
  </p>
</footer>
