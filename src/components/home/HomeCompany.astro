---
import PersonAvatar from "./PersonAvatar.astro";

export interface Person {
  name: string;
  image: string;
}

export interface Props {
  people: Person[];
}

const { people } = Astro.props;
---

<section
  id="compagnia"
  class="py-20 px-4 lg:px-20 bg-neutral text-neutral-content text-center"
>
  <h2 class="text-3xl font-serif mb-12 uppercase italic tracking-tighter">
    I Protagonisti
  </h2>
  <div
    class="flex flex-wrap justify-center gap-8 font-semibold uppercase text-xs tracking-widest"
  >
    {people.map((p) => <PersonAvatar name={p.name} imageSrc={p.image} />)}
  </div>
</section>
